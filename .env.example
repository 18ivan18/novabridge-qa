# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Comments stay on their own lines so every .env parser (including docker's) reads values cleanly.

# --- LLM ---
# openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
# Groq by default. Also: http://ollama:11434/v1 or https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Check the provider's current model list.
LLM_MODEL=
ANTHROPIC_API_KEY=
# Check Anthropic's current model list.
ANTHROPIC_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# --- Embeddings ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# cpu, or mps for a faster local run on Apple silicon.
EMBEDDING_DEVICE=cpu

# --- Ingestion and retrieval ---
DATA_DIR=./data
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
RETRIEVAL_CANDIDATES=20
TOP_K=6
RRF_K=60
# Tuned in M4; document the chosen value.
MIN_RELEVANCE=0.35
MAX_UPLOAD_MB=20
# Comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- Corpus ---
# Required by SEC EDGAR, e.g. "Your Name your@email"
SEC_USER_AGENT=
